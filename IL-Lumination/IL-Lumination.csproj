<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>Illumination</RootNamespace>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>Nullable</WarningsAsErrors>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Version>1.0.0-beta1</Version>
        <Authors>Nick Strupat</Authors>
        <WeaverConfiguration>
            <Weavers>
                <RuntimeNullables CheckNonPublic="true" CheckOutputs="true" />
            </Weavers>
        </WeaverConfiguration>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="EqCmp" Version="1.0.0-beta4" />
        <PackageReference Include="Lokad.ILPack" Version="0.2.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.1" />
        <PackageReference Include="RuntimeNullables.Fody" Version="2.0.0" />
        <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.2" />
    </ItemGroup>
    
</Project>
